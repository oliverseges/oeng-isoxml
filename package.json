{
  "name": "oeng-isoxml-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Oliver Engermann",
  "homepage": "https://oliverseges.github.io/oeng-isoxml/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverseges/oeng-isoxml.git"
  },
  "bugs": {
    "url": "https://github.com/oliverseges/oeng-isoxml/issues"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write .",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:performance": "node scripts/generate-performance-fixtures.mjs",
    "icons:generate": "node scripts/generate-favicon.mjs",
    "ddi:sync": "node scripts/sync-isobus-ddi.mjs"
  },
  "dependencies": {
    "@mapbox/shp-write": "^0.4.3",
    "@tanstack/react-virtual": "^3.13.12",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.2.5",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.536.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.0.14",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^7.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fast-check": "^4.2.0",
    "prettier": "^3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
